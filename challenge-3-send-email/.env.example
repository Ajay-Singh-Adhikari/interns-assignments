# Copy this file to .env and fill in your details. Never commit .env.

# SMTP settings. For Gmail, turn on 2-Step Verification, then create an
# App Password at https://myaccount.google.com/apppasswords and use it as
# SMTP_PASS (your normal Gmail password will not work).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your.email@gmail.com
SMTP_PASS=your-16-char-app-password

# Optional: defaults to SMTP_USER
MAIL_FROM=
# Recipient. While testing, set this to your own address (or use --to).
MAIL_TO=hr@ignitershub.com

# Student details included in the email body
STUDENT_NAME=Your Name
STUDENT_SEMESTER=6
STUDENT_BRANCH=Computer Science and Engineering
STUDENT_ROLL_NUMBER=1234567

# PNG, JPG or JPEG image to attach, relative to this folder
ATTACHMENT_PATH=assets/sample.png
